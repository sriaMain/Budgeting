# Vendor Onboarding portal - the public URL vendors open from their own
# device. Swap this line (do not hard-code it in source) as you move between
# environments:
#   local:      VENDOR_PORTAL_URL=http://localhost:5173
#   tunnel:     VENDOR_PORTAL_URL=https://xxxx.ngrok-free.app
#   production: VENDOR_PORTAL_URL=https://vendor.yourcompany.com

VENDOR_PORTAL_URL=https://project.nxsys.in

# Employee Onboarding portal - same idea as VENDOR_PORTAL_URL above, but for
# the self-onboarding link an employee opens from their invite email. Falls
# back to FRONTEND_BASE_URL (localhost) when unset, which is why invite
# emails were pointing at localhost instead of the real domain:
#   local:      EMPLOYEE_PORTAL_URL=http://localhost:5173
#   tunnel:     EMPLOYEE_PORTAL_URL=https://xxxx.ngrok-free.app
#   production: EMPLOYEE_PORTAL_URL=https://vendor.yourcompany.com

# EMPLOYEE_PORTAL_URL=https://project.nxsys.in

# Branding shown in Vendor Onboarding emails. Both are optional - if left
# unset, COMPANY_NAME defaults to "SRIA INFOTECH PRIVATE LTD" and the header
# falls back to a text-only company name (no broken image icon) instead of a
# logo. COMPANY_LOGO_URL must be a full https:// link to a hosted image -
# email clients cannot load local/relative file paths.
# COMPANY_NAME=SRIA INFOTECH PRIVATE LTD
# COMPANY_LOGO_URL=https://your-public-domain.com/logo.png