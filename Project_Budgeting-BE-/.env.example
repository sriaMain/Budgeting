# Copy this file to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=changeme
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Postgres connection string, e.g. postgresql://user:password@host:port/dbname)
# Leave unset to fall back to local sqlite3 (db.sqlite3)
DATABASE_URL=

# Whether the app is served over HTTPS (affects secure cookie flags)
HTTPS_ENABLED=False

# Email (SMTP)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis / Celery
REDIS_CACHE_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CHANNEL_LAYERS_REDIS_URL=

# Frontend / portal URLs used to build links in emails
FRONTEND_BASE_URL=http://localhost:5173
VENDOR_PORTAL_URL=
EMPLOYEE_PORTAL_URL=

# Branding shown in outgoing emails
COMPANY_NAME=
COMPANY_LOGO_URL=
COMPANY_WEBSITE=
COMPANY_EMAIL=
COMPANY_PHONE=
